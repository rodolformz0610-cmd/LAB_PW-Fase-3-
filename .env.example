# Copiar como .env. Este archivo debe estar FUERA de public/.
APP_ENV=demo
APP_URL=http://127.0.0.1:8765
SESSION_NAME=nexo_session
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bd_fase2
DB_USER=nexo_app
DB_PASSWORD=
DB_SSLMODE=require
COOKIE_SECURE=0
# Para produccion: APP_ENV=production, COOKIE_SECURE=1 y HTTPS.
# Para Supabase: DB_DRIVER=pgsql, puerto 5432 y datos de Connect > Session pooler.
